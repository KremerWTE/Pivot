# =============================================
# Pivot — .gitignore
# =============================================

# -------------------------
# Environment & Secrets
# -------------------------
.env
.env.*
!.env.example
*.env
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# -------------------------
# OS Generated
# -------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -------------------------
# IDE & Editor
# -------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~
.vs/

# -------------------------
# Claude Code
# -------------------------
.claude/settings.local.json

# -------------------------
# Node / JavaScript
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/
dist/
build/
.next/
.nuxt/
coverage/
*.tgz

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# -------------------------
# .NET / C#
# -------------------------
bin/
obj/
*.user
*.suo
.vs/
*.nupkg
*.snupkg
project.lock.json
artifacts/
TestResults/
*.coverage
*.coveragexml

# -------------------------
# Java
# -------------------------
target/
*.class
*.jar
*.war
*.ear
.gradle/
build/

# -------------------------
# Logs
# -------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

# -------------------------
# Temporary Files
# -------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.orig

# -------------------------
# Data Files (sensitive)
# -------------------------
data/sensitive/
data/private/
data/*.csv
data/*.xlsx
data/*.xls
data/*.json
!data/seeds/
!data/sample/
!data/.gitkeep

# -------------------------
# Build Artifacts
# -------------------------
*.zip
*.tar.gz
*.tgz

# -------------------------
# Media & Transcription (large files)
# -------------------------
*.mp4
*.wav
*.mp3
solmed_audio.*
solmed_transcript.*
solmed_screenshots/

# -------------------------
# Docker
# -------------------------
.docker/
docker-compose.override.yml
